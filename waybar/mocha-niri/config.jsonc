{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 33,
  "modules-left": [
    "niri/workspaces",
    "custom/workspace-1",
    "custom/workspace-2",
    "custom/workspace-3",
    "custom/workspace-4",
    "custom/workspace-5",
    "custom/workspace-6",
    "custom/workspace-7",
    "custom/workspace-8",
    "custom/workspace-9",
    "custom/workspace-10"
  ],
  "modules-center": ["clock"],
  "modules-right": [
    "group/tray-expander",
    "network",
    "bluetooth",
    "pulseaudio",
    "cpu",
    "battery",
  ],

  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "default": "",
      "magic": "一",
      "1": "一",
      "2": "二",
      "3": "三",
      "4": "四",
      "5": "五",
      "6": "六",
      "7": "七",
      "8": "八",
      "9": "九",
      "10": "十",
      "0": "十"
    }
  },

  "custom/workspace-1": {
    "exec": "$HOME/.config/waybar/mocha-niri/niri-workspace.sh 1",
    "return-type": "json",
    "interval": 1,
    "format": "{text}",
    "hide-empty-text": true,
    "tooltip": false,
    "on-click": "niri msg action focus-workspace 1"
  },

  "custom/workspace-2": {
    "exec": "$HOME/.config/waybar/mocha-niri/niri-workspace.sh 2",
    "return-type": "json",
    "interval": 1,
    "format": "{text}",
    "hide-empty-text": true,
    "tooltip": false,
    "on-click": "niri msg action focus-workspace 2"
  },

  "custom/workspace-3": {
    "exec": "$HOME/.config/waybar/mocha-niri/niri-workspace.sh 3",
    "return-type": "json",
    "interval": 1,
    "format": "{text}",
    "hide-empty-text": true,
    "tooltip": false,
    "on-click": "niri msg action focus-workspace 3"
  },

  "custom/workspace-4": {
    "exec": "$HOME/.config/waybar/mocha-niri/niri-workspace.sh 4",
    "return-type": "json",
    "interval": 1,
    "format": "{text}",
    "hide-empty-text": true,
    "tooltip": false,
    "on-click": "niri msg action focus-workspace 4"
  },

  "custom/workspace-5": {
    "exec": "$HOME/.config/waybar/mocha-niri/niri-workspace.sh 5",
    "return-type": "json",
    "interval": 1,
    "format": "{text}",
    "hide-empty-text": true,
    "tooltip": false,
    "on-click": "niri msg action focus-workspace 5"
  },

  "custom/workspace-6": {
    "exec": "$HOME/.config/waybar/mocha-niri/niri-workspace.sh 6",
    "return-type": "json",
    "interval": 1,
    "format": "{text}",
    "hide-empty-text": true,
    "tooltip": false,
    "on-click": "niri msg action focus-workspace 6"
  },

  "custom/workspace-7": {
    "exec": "$HOME/.config/waybar/mocha-niri/niri-workspace.sh 7",
    "return-type": "json",
    "interval": 1,
    "format": "{text}",
    "hide-empty-text": true,
    "tooltip": false,
    "on-click": "niri msg action focus-workspace 7"
  },

  "custom/workspace-8": {
    "exec": "$HOME/.config/waybar/mocha-niri/niri-workspace.sh 8",
    "return-type": "json",
    "interval": 1,
    "format": "{text}",
    "hide-empty-text": true,
    "tooltip": false,
    "on-click": "niri msg action focus-workspace 8"
  },

  "custom/workspace-9": {
    "exec": "$HOME/.config/waybar/mocha-niri/niri-workspace.sh 9",
    "return-type": "json",
    "interval": 1,
    "format": "{text}",
    "hide-empty-text": true,
    "tooltip": false,
    "on-click": "niri msg action focus-workspace 9"
  },

  "custom/workspace-10": {
    "exec": "$HOME/.config/waybar/mocha-niri/niri-workspace.sh 10",
    "return-type": "json",
    "interval": 1,
    "format": "{text}",
    "hide-empty-text": true,
    "tooltip": false,
    "on-click": "niri msg action focus-workspace 10"
  },

  "cpu": {
    "interval": 5,
    "format": "",
    "on-click": "kitty -e btop"
  },
  "clock": {
    "markup": "pango",
    "format": "<span color='#cdd6f4'>{:%I:%M %a}</span>",
    "format-alt": "{:%I:%M %p}",
    "on-click-right": "swaync-client -t",
    "tooltip": false
  },
  "network": {
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰀂",
    "format-disconnected": "󰖪",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "spacing": 1,
    "on-click": "nmgui"
  },
  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-no-controller": "󰂲",
    "format-connected": "󰂱",
    "format-connected-battery": "󰂱",
    "tooltip-format": "{controller_alias}",
    "tooltip-format-connected": "{controller_alias}\n{device_enumerate}",
    "tooltip-format-connected-battery": "{controller_alias}\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_alias} {device_battery_percentage}%",
    "on-click": "blueman-manager"
  },
  "battery": {
    "format": "{icon}",
    "format-discharging": "{icon}",
    "format-charging": "{icon}",
    "format-icons": {
      "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
      "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "format-full": "󰂅",
    "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
    "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
    "interval": 5,
    "on-click": "",
    "states": {
      "warning": 20,
      "critical": 10
    }
  },
  
  "custom/weather": {
    "exec": "$HOME/.config/waybar/mocha-niri/weather/weather.sh",
    "return-type": "json",
    "interval": 60,
    "tooltip": false,
    "on-click": "notify-send -u low Weather \"$($HOME/.config/waybar/mocha-niri/weather/weather-status)\""
  },

  "pulseaudio": {
    "format": "{icon}",
    "on-click": "pavucontrol",
    "tooltip-format": "Playing at {volume}%",
    "scroll-step": 5,
    "format-muted": "󰝟",
    "format-icons": {
      "default": ["", "", ""]
    }
  },
  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item"
    },
    "modules": ["custom/expand-icon", "tray"]
  },
  "custom/expand-icon": {
    "format": " ",
    "tooltip": false,
    "on-click": "$HOME/.config/powermenu/powermenu.sh"
  },
  "tray": {
    "icon-size": 15,
    "spacing": 12
  }
}
