
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "$HOME/.config/fastfetch/blackarch.txt",
        "color": {
            "1": "#7aa2f7",
            "2": "#7aa2f7",
            "3": "#7aa2f7",
            "4": "#7aa2f7",
            "5": "#7aa2f7",
            "6": "#7aa2f7",
            "7": "#7aa2f7",
            "8": "#7aa2f7",
            "9": "#7aa2f7"
        },
        "padding": {
            "top": 2,
            "right": 6
        }
    },
    "display": {
        "separator": " • "
    },
    "modules": [
        "break",
        "break",
        {
            "type": "title",
            "color": {
                "user": "#7aa2f7",
                "at": "#cdd6f4",
                "host": "#7aa2f7"
            }
        },
        "break",
        {
            "type": "os",
            "key": "distribution ",
            "keyColor": "#7aa2f7"
        },
        {
            "type": "kernel",
            "key": "linux kernel ",
            "keyColor": "#7aa2f7"
        },
        {
            "type": "packages",
            "format": "{} (pacman)",
            "key": "packages ",
            "keyColor": "#7aa2f7"
        },
        {
            "type": "shell",
            "key": "unix shell ",
            "keyColor": "#7aa2f7"
        },
        {
            "type": "terminal",
            "key": "terminal ",
            "keyColor": "#7aa2f7"
        },
        {
            "type": "wm",
            "format": "{} ({3})",
            "key": "window manager ",
            "keyColor": "#7aa2f7"
        },
        {
            "type": "de",
            "key": "desktop env ",
            "keyColor": "#7aa2f7"
        },
        {
            "type": "uptime",
            "key": "uptime ",
            "keyColor": "#7aa2f7"
        },
        {
            "type": "host",
            "key": "host ",
            "keyColor": "#7aa2f7"
        },
        {
            "type": "cpu",
            "key": "cpu ",
            "keyColor": "#7aa2f7"
        },
        {
            "type": "gpu",
            "key": "gpu ",
            "keyColor": "#7aa2f7"
        },
        {
            "type": "memory",
            "key": "memory ",
            "keyColor": "#7aa2f7"
        },
        {
            "type": "swap",
            "key": "swap ",
            "keyColor": "#7aa2f7"
        },
        {
            "type": "disk",
            "key": "disk ",
            "keyColor": "#7aa2f7"
        },
        {
            "type": "display",
            "key": "display ",
            "keyColor": "#7aa2f7"
        },
        {
            "type": "localip",
            "key": "local ip ",
            "keyColor": "#7aa2f7"
        },
        {
            "type": "datetime",
            "key": "datetime ",
            "keyColor": "#7aa2f7"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle",
            "colors": [
                "#89b4fa",
                "#f38ba8",
                "#a6e3a1",
                "#fab387",
                "#f9e2af",
                "#7aa2f7",
                "#94e2d5",
                "#cdd6f4"
            ]
        },
        "break",
        "break"
    ]
}
